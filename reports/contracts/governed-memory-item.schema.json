{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ocor:schema:governed-memory-item:1.0",
  "title": "OCOR GovernedMemoryItem Full PoC Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "memory_item_id",
    "memory_version",
    "memory_kind",
    "memory_scope",
    "owner_principal_id",
    "tenant_id",
    "organization_id",
    "domain_id",
    "compartments",
    "classification_marking_ref",
    "purpose",
    "content_schema_ref",
    "content_ref",
    "content_digest",
    "source_kind",
    "source_ref",
    "source_digest",
    "evidence_refs",
    "provenance_refs",
    "derived_from_refs",
    "consolidates_refs",
    "created_at",
    "valid_from",
    "retention_policy_ref",
    "confidence",
    "policy_bundle_digest",
    "ontology_release_digest",
    "governed_context_digest",
    "instruction_eligible",
    "taint_labels",
    "representation_kinds",
    "lifecycle_status"
  ],
  "properties": {
    "memory_item_id": {"type": "string", "minLength": 1},
    "memory_version": {"type": "integer", "minimum": 1},
    "memory_kind": {"enum": ["WORKING", "EPISODIC", "SEMANTIC", "PROCEDURAL", "PREFERENCE", "REFLECTION", "DISSENT", "TEAM_SHARED"]},
    "memory_scope": {"enum": ["RUN", "TASK", "AGENT", "TEAM", "PROJECT", "DOMAIN", "FEDERATED"]},
    "owner_principal_id": {"type": "string", "minLength": 1},
    "agent_run_id": {"type": "string", "minLength": 1},
    "team_run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "team_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "federation_policy_ref": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "organization_id": {"type": "string", "minLength": 1},
    "domain_id": {"type": "string", "minLength": 1},
    "compartments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "classification_marking_ref": {"$ref": "#/$defs/digest"},
    "purpose": {"type": "string", "minLength": 1},
    "content_schema_ref": {"type": "string", "minLength": 1},
    "content_ref": {"type": "string", "minLength": 1},
    "content_digest": {"$ref": "#/$defs/digest"},
    "language": {"type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
    "source_kind": {"enum": ["OBSERVATION", "EVIDENCE", "TOOL_RESULT", "HUMAN_INPUT", "MODEL_OUTPUT", "DERIVED_SUMMARY", "PROCEDURE", "PREFERENCE", "MEMORY_CONSOLIDATION"]},
    "source_ref": {"type": "string", "minLength": 1},
    "source_digest": {"$ref": "#/$defs/digest"},
    "evidence_refs": {"$ref": "#/$defs/nonEmptyRefs"},
    "provenance_refs": {"$ref": "#/$defs/nonEmptyRefs"},
    "derived_from_refs": {"$ref": "#/$defs/refs"},
    "consolidates_refs": {"$ref": "#/$defs/refs"},
    "supersedes_ref": {"type": "string", "minLength": 1},
    "correction_of_ref": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "retention_policy_ref": {"type": "string", "minLength": 1},
    "legal_hold_ref": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "uncertainty_ref": {"type": "string", "minLength": 1},
    "policy_bundle_digest": {"$ref": "#/$defs/digest"},
    "ontology_release_digest": {"$ref": "#/$defs/digest"},
    "governed_context_digest": {"$ref": "#/$defs/digest"},
    "instruction_eligible": {"type": "boolean", "default": false},
    "instruction_approval_ref": {"type": "string", "minLength": 1},
    "taint_labels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "representation_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["STRUCTURED", "FULL_TEXT", "VECTOR"]}},
    "embedding_model_ref": {"type": "string", "minLength": 1},
    "embedding_model_digest": {"$ref": "#/$defs/digest"},
    "embedding_dimensions": {"type": "integer", "minimum": 1},
    "embedding_normalization_profile": {"type": "string", "minLength": 1},
    "embedding_ref": {"type": "string", "minLength": 1},
    "embedding_digest": {"$ref": "#/$defs/digest"},
    "lifecycle_status": {"enum": ["PROPOSED", "ACTIVE", "QUARANTINED", "SUPERSEDED", "REVOKED", "EXPIRED", "LEGAL_HOLD", "DELETION_PENDING", "DELETION_INCOMPLETE", "DELETED"]},
    "prior_lifecycle_status": {"enum": ["ACTIVE", "QUARANTINED", "SUPERSEDED", "REVOKED", "EXPIRED"]},
    "deletion_epoch": {"type": "integer", "minimum": 0}
  },
  "allOf": [
    {"if": {"properties": {"memory_scope": {"const": "RUN"}}}, "then": {"required": ["agent_run_id"]}},
    {"if": {"properties": {"memory_scope": {"const": "TASK"}}}, "then": {"required": ["agent_run_id", "task_id"]}},
    {"if": {"properties": {"memory_scope": {"const": "AGENT"}}}, "then": {"required": ["agent_id"]}},
    {"if": {"properties": {"memory_scope": {"const": "TEAM"}}}, "then": {"required": ["team_id"]}},
    {"if": {"properties": {"memory_scope": {"const": "PROJECT"}}}, "then": {"required": ["project_id"]}},
    {"if": {"properties": {"memory_scope": {"const": "FEDERATED"}}}, "then": {"required": ["federation_policy_ref"]}},
    {"if": {"properties": {"representation_kinds": {"contains": {"const": "VECTOR"}}}}, "then": {"required": ["embedding_model_ref", "embedding_model_digest", "embedding_dimensions", "embedding_normalization_profile", "embedding_ref", "embedding_digest"]}},
    {"if": {"properties": {"instruction_eligible": {"const": true}}}, "then": {"required": ["instruction_approval_ref"]}},
    {"if": {"properties": {"lifecycle_status": {"const": "LEGAL_HOLD"}}}, "then": {"required": ["legal_hold_ref", "prior_lifecycle_status"]}},
    {"if": {"properties": {"lifecycle_status": {"enum": ["DELETION_PENDING", "DELETION_INCOMPLETE", "DELETED"]}}}, "then": {"required": ["deletion_epoch"]}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^urn:sha256:[0-9a-f]{64}$"},
    "refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "nonEmptyRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
