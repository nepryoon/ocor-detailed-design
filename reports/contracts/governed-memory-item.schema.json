{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ocor:schema:governed-memory-item:1.0",
  "title": "OCOR GovernedMemoryItem PoC Bounded Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "memory_item_id",
    "owner_principal_id",
    "agent_run_id",
    "team_run_id",
    "task_id",
    "tenant_id",
    "organization_id",
    "domain_id",
    "compartments",
    "classification_marking_ref",
    "purpose",
    "source_kind",
    "source_ref",
    "source_digest",
    "evidence_refs",
    "provenance_refs",
    "created_at",
    "valid_from",
    "expires_at",
    "confidence",
    "retention_policy_ref",
    "policy_bundle_digest",
    "ontology_release_digest",
    "governed_context_digest",
    "instruction_eligible",
    "taint_labels",
    "content_ref",
    "content_digest",
    "status"
  ],
  "properties": {
    "memory_item_id": {"type": "string", "minLength": 1},
    "owner_principal_id": {"type": "string", "minLength": 1},
    "agent_run_id": {"type": "string", "minLength": 1},
    "team_run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "organization_id": {"type": "string", "minLength": 1},
    "domain_id": {"type": "string", "minLength": 1},
    "compartments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "classification_marking_ref": {"$ref": "#/$defs/digest"},
    "purpose": {"type": "string", "minLength": 1},
    "source_kind": {"enum": ["OBSERVATION", "EVIDENCE", "TOOL_RESULT", "HUMAN_INPUT", "MODEL_OUTPUT", "DERIVED_SUMMARY"]},
    "source_ref": {"type": "string", "minLength": 1},
    "source_digest": {"$ref": "#/$defs/digest"},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "provenance_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "format": "date-time"},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "retention_policy_ref": {"type": "string", "minLength": 1},
    "policy_bundle_digest": {"$ref": "#/$defs/digest"},
    "ontology_release_digest": {"$ref": "#/$defs/digest"},
    "governed_context_digest": {"$ref": "#/$defs/digest"},
    "instruction_eligible": {"type": "boolean", "default": false},
    "taint_labels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "content_ref": {"type": "string", "minLength": 1},
    "content_digest": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["ACTIVE", "EXPIRED", "REVOKED", "QUARANTINED", "DELETED"]}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^urn:sha256:[0-9a-f]{64}$"}
  }
}
