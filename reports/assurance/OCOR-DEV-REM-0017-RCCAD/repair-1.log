=== live_teardown.py; original_sha256=a884e76ad8afb9b380bfaf8cd325b6775f51f7873548bd076e6a5cf0eb2fde71 ===
import json,subprocess,sys,os,hashlib
from pathlib import Path
from datetime import datetime,timezone
root=Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/ocor-dev-rem-0017-ci-provision-spire');out=Path(__file__).parent
sys.path.insert(0,str(root/'scripts'))
from bootstrap_ci_environment import owned_resources,teardown
from ocor_bootstrap_lib import BootstrapError
# Exact helper under test, real Docker. Failure and baseline resources remain visible.
result={"started_at":datetime.now(timezone.utc).isoformat()}
result['normal']=teardown(root)
before=json.loads((out/'before-suite-volumes.json').read_text())
current=subprocess.check_output(['docker','volume','ls','-q'],text=True).split()
created=sorted(set(current)-set(before))
result['suite_residual_volumes']=created
removed=[]
for name in created:
 details=json.loads(subprocess.check_output(['docker','volume','inspect',name],text=True))[0]
 labels=details.get('Labels') or {}
 users=subprocess.check_output(['docker','ps','-aq','--filter','volume='+name],text=True).split()
 if len(name)!=64 or any(c not in '0123456789abcdef' for c in name) or 'com.docker.volume.anonymous' not in labels or users:
  raise RuntimeError('ambiguous volume ownership; not removed: '+name)
 subprocess.run(['docker','volume','rm',name],check=True,capture_output=True,text=True,timeout=15)
 removed.append(name)
result['session_only_removed_volumes']=removed
credentials=root/'.ocor/bootstrap.env';saved=out/'after-suite-bootstrap.env'
credentials.rename(saved)
probe='ocor-rem0017-teardown-probe-'+str(os.getpid());network=None
try:
 result['missing_env_no_resources']=teardown(root)
 network=subprocess.check_output(['docker','network','create','--label','com.docker.compose.project=ocor-bootstrap',probe],text=True,timeout=15).strip()
 try:
  teardown(root)
 except BootstrapError as exc:
  result['missing_env_owned_resource']={"result":"EXPECTED_REJECTION","error":str(exc)}
 else:
  raise RuntimeError('negative probe incorrectly accepted')
 assert network in subprocess.check_output(['docker','network','ls','-q','--no-trunc'],text=True).split()
finally:
 if network:subprocess.run(['docker','network','rm',network],check=True,capture_output=True,text=True,timeout=15)
 saved.rename(credentials)
result['final_residual']=owned_resources(root)
assert not any(result['final_residual'].values())
result['baseline_non_suite_volumes_present']=set(before)-set(subprocess.check_output(['docker','volume','ls','-q'],text=True).split())
# Baseline includes bootstrap volumes; those are deliberately removed by project teardown.
result['baseline_non_suite_volumes_present']=sorted(result['baseline_non_suite_volumes_present'])
result['finished_at']=datetime.now(timezone.utc).isoformat()
result['status']='PASS'
(out/'live-teardown-result.json').write_text(json.dumps(result,indent=2,sort_keys=True)+'\n')
print(json.dumps(result))

