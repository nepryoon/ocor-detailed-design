{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ocor.dev/v1.2/marking-scheme-definition.schema.json",
  "title": "MarkingSchemeDefinition",
  "description": "A finite total order or explicit finite lattice. Relations are lower-to-upper.",
  "type": "object",
  "properties": {
    "schemeId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9.-]{0,63}$"
    },
    "schemeVersion": {"type": "string", "minLength": 1},
    "orderedLabels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/label"}
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/label"}
    },
    "relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relation"}
    }
  },
  "required": ["schemeId", "schemeVersion"],
  "oneOf": [
    {
      "properties": {
        "orderedLabels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/label"}
        }
      },
      "required": ["orderedLabels"]
    },
    {
      "properties": {
        "labels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/label"}
        },
        "relations": {
          "type": "array",
          "items": {"$ref": "#/$defs/relation"}
        }
      },
      "required": ["labels", "relations"]
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Z][A-Z0-9_-]*$"
    },
    "relation": {
      "type": "object",
      "properties": {
        "lower": {"$ref": "#/$defs/label"},
        "upper": {"$ref": "#/$defs/label"}
      },
      "required": ["lower", "upper"],
      "additionalProperties": false
    }
  }
}
