{
  "$id": "urn:ocor:services-lock:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "build": {
      "additionalProperties": false,
      "properties": {
        "base_image": {"pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$", "type": "string"},
        "dockerfile": {"pattern": "^infra/[A-Za-z0-9_./-]+$", "type": "string"},
        "output_image": {"pattern": "^[a-z0-9_./-]+:[a-zA-Z0-9_.-]+$", "type": "string"},
        "output_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "source_sha512": {"pattern": "^[0-9a-f]{128}$", "type": "string"}
      },
      "required": ["base_image", "dockerfile", "source_sha512", "output_image", "output_sha256"],
      "type": "object"
    },
    "service": {
      "additionalProperties": false,
      "oneOf": [
        {"required": ["image"], "not": {"required": ["build"]}},
        {"required": ["build"], "not": {"required": ["image"]}}
      ],
      "properties": {
        "build": {"$ref": "#/$defs/build"},
        "id": {"pattern": "^[a-z0-9-]+$", "type": "string"},
        "image": {"pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$", "type": "string"},
        "license": {"minLength": 1, "type": "string"},
        "official_source": {"const": true},
        "source": {"pattern": "^https://", "type": "string"},
        "version": {"minLength": 1, "type": "string"}
      },
      "required": ["id", "version", "source", "official_source", "license"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "acquired_at": {"format": "date-time", "type": "string"},
    "architecture": {"const": "x86_64"},
    "schema_version": {"const": "1.0"},
    "services": {"items": {"$ref": "#/$defs/service"}, "minItems": 1, "type": "array", "uniqueItems": true}
  },
  "required": ["schema_version", "architecture", "acquired_at", "services"],
  "type": "object"
}
